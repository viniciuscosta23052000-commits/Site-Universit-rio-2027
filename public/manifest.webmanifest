{
  "name": "Caderno Digital Universitário",
  "short_name": "Caderno",
  "description": "Central de organização acadêmica, cadernos digitais, grade horária, flashcards e mapas mentais.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F4F1EA",
  "theme_color": "#747B6A",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Novo Caderno",
      "short_name": "Caderno",
      "description": "Criar novo caderno de estudos",
      "url": "/?action=new-notebook",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Nova Anotação",
      "short_name": "Aula",
      "description": "Criar nova aula no caderno",
      "url": "/?action=new-note",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Flashcards",
      "short_name": "Flashcards",
      "description": "Revisar flashcards com repetição espaçada",
      "url": "/?tab=flashcards",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Grade Horária",
      "short_name": "Grade",
      "description": "Ver grade de horários da semana",
      "url": "/?tab=schedule",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
